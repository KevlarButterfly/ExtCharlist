@page "/login"
@using ExtCharistWebApp.Services
@using ExtCharlistLibrary.DTO
@inject ILoginService LoginService
@inject NavigationManager NavManager

<h3>Login</h3>
@* <form method='post'>
    <p>
        <label>Email</label><br />
