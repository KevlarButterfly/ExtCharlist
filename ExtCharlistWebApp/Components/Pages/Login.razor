@page "/login"
@using ExtCharistWebApp.Services
@using ExtCharlistLibrary.DTO
@inject ILoginService LoginService
@inject NavigationManager NavManager
@inject IHttpContextAccessor httpContextAccessor

<h3>Login</h3>
@* <form method='post'>
    <p>
        <label>Email</label><br />
        <input name='email' />
    </p>
    <p>
        <label>Password</label><br />
        <input type='password' name='password' />
    </p>
    <input type='submit' value='Login' onclick="() => OnSubmitAsync(@h)"/>
</form> *@


<EditForm Model = "@UserDTO" OnValidSubmit="HandleValidSubmit" OnInvalidSubmit="HandleInvalidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />
    
    <InputText id="email"
               @bind-Value="UserDTO.Email"/>
    <InputText id="password" @bind-Value="UserDTO.Password" type="password" />
    <button type="submit">Login</button>    
   @if(ShowRegisterLink)
   {
        <p>Don't have an account? <a @onclick='() => navigationManager.NavigateTo("/register")'>Register here</a></p>
    }
    )
</EditForm>
@code {

    private ValidationMessageStore messageStore;
    private UserDTO UserDTO = new UserDTO();
    [Inject]
    private NavigationManager navigationManager { get; set; }
    private bool ShowRegisterLink = false;

    protected override async Task OnInitializedAsync()
    {
        UserDTO signedInUser = await LoginService.HasUserSignedIn();
        if (signedInUser != null)
        {
            navigationManager.NavigateTo($"/{signedInUser.Id}");
        }

    }
    private async Task HandleValidSubmit(EditContext context)
    {
        bool success = await LoginService.OnLoginAsync(UserDTO);
        messageStore = new ValidationMessageStore(context);
        if (!success)
        {

            messageStore.Clear();
            messageStore.Add(() => UserDTO.Email, "Invalid email or password.");
            context.NotifyValidationStateChanged();
            ShowRegisterLink = true;
            return;
        }
        messageStore.Clear();
        navigationManager.NavigateTo($"/{await LoginService.GetLoggedIdAsync()}");
    }
    private async Task HandleInvalidSubmit()
    {
    }
    async void OnSubmit(EditContext context)
    {
        bool k = context.Validate();
        if (!k) return;
        messageStore = new ValidationMessageStore(context);
        messageStore.Clear();
        Console.WriteLine($"Redirecting to page /{await LoginService.GetLoggedIdAsync()}");
        navigationManager.NavigateTo($"/{await LoginService.GetLoggedIdAsync()}");
    }

}
