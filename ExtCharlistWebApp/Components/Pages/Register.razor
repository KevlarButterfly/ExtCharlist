    <input type='submit' value='Login' onclick="() => OnSubmitAsync(@h)"/>
</form> *@

<EditForm Model="@userDTO" OnValidSubmit="HandleValidSubmit" OnInvalidSubmit="HandleInvalidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <span>Username</span>
    <InputText id="username" @bind-Value="userDTO.UserName" /> <br />
    
    <span>Email</span>
    <InputText id="email"
               @bind-Value="userDTO.Email" /><br />
    <span>Password</span>
    <InputText id="password" @bind-Value="userDTO.Password" type="password" /><br />
    <span>Repeat password</span>
    <InputText id="password-repeat" @bind-Value="DoubledPassword" type="password"/> <br />
    
    <button type="submit">Register</button><br />
    @if(ShowLoginLink)
    {
        <p>Already have an account? <a @onclick='() => navigationManager.NavigateTo("/login")'>Login here</a></p>
    }
    
    
</EditForm>

@code {

    private bool ShowLoginLink = false;
    private ValidationMessageStore messageStore;
    private UserDTO userDTO = new UserDTO();
    private string DoubledPassword;

    [Inject]
    private NavigationManager navigationManager { get; set; }

    protected override async Task OnInitializedAsync()
    {
        UserDTO signedInUser = await LoginService.HasUserSignedIn();
        if (signedInUser != null)
        {
            navigationManager.NavigateTo($"/{signedInUser.Id}");
        }
    }
    private async Task HandleValidSubmit(EditContext context)
    {
        if(userDTO.Password != DoubledPassword)
        {
            messageStore = new ValidationMessageStore(context);
            messageStore.Clear();
            messageStore.Add(() => userDTO.Password, "Passwords do not match.");
            context.NotifyValidationStateChanged();
            return;
        }
        userDTO.UserRole = new("user");
        
        bool success = await LoginService.OnRegisterAsync(userDTO);
        if (!success)
        {
            messageStore = new ValidationMessageStore(context);
            messageStore.Clear();
            messageStore.Add(() => userDTO.Email, "User with this email already exists.");
            context.NotifyValidationStateChanged();
            ShowLoginLink = true;
            return;
        }
    }
    private async Task HandleInvalidSubmit()
    {
        messageStore.Clear();
    }
    async void OnSubmit(EditContext context)
    {
        bool k = context.Validate();
        if (!k) return;
        messageStore = new ValidationMessageStore(context);
        messageStore.Clear();
        navigationManager.NavigateTo($"/{userDTO.Id}");
    }

}
