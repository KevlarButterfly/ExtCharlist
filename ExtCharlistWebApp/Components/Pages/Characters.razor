@page "/{UserId}/characters/"
@using ExtCharistWebApp.Services
@using ExtCharlistWebApp.Services
@using ExtCharlistLibrary.DTO
@using Microsoft.AspNetCore.Http.Extensions
@inject ICharacterService CharacterService
@inject ILoginService LoginService
@inject NavigationManager NavigationManager
@rendermode InteractiveAuto
<PageTitle>huh?</PageTitle>
@if (characters is null){
    <h1>нема результатов</h1>;
}
else{
    @foreach(CharacterDTO character in characters){
        <div @onclick="@(e=>Filler(character.Id))")>
        <h1>Character:@character.CharacterName</h1>
        <ul>
                @if (character.CharacterRace != null)
                {
                    <li>Race:
                        @character.CharacterRace.RaceName</li>
                }
                @if (character.CharacterClass != null)
                {
                    <li>Class:@character.CharacterClass.ClassName</li>
                }
                <li>Level:@character.level</li>
        </ul>
        </div>
    }

}
<div class="char-button-choise">
    <button @onclick="OnCharacterCreationAsync"> Create new character</button>

</div>

@code {
    IEnumerable<CharacterDTO>? characters;
    [Parameter]
    public string? UserId { get; set; }
    protected override async Task OnInitializedAsync()
    {
        UserDTO signedInUser = await LoginService.GetSignedInUserAsync();
        if (signedInUser.Id != UserId)
        {
            NavigationManager.NavigateTo("/login");
        }
        characters = await CharacterService.GetCharactersAsync(UserId);
        foreach(CharacterDTO character in characters)
        {
            Console.WriteLine(character.Id);
        }
    }

    protected async void Filler(string id)
    {
        RedirectToCharacterAsync(id);
    }

    private async Task OnCharacterCreationAsync()
    {
        CharacterDTO character = await CharacterService.CreateCharacterAsync();
        await Task.Delay(1000);
        await RedirectToCharacterAsync(character.Id);
    }

    
    protected async Task RedirectToCharacterAsync(string id)
    {
        Console.WriteLine("Redirecting to character with id: " + id);
        NavigationManager.NavigateTo($"/{UserId}/characters/{id}");
    }
    
    


}
