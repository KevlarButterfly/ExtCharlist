 <style>
    .menu-nav {
        background: #6082B6;
        display:flex;
        flex-direction:row;
        height:60px;
        
    }
    .buttons{
        display: flex;
        flex-direction: row;
        justify-content: space-around;
        width: 90%;
    }
    .nav-item{
        border: groove;
        border-color: black;
        padding-top:10px;
    }
 </style>
 <nav class="menu-nav">
    <div class="buttons">
        <div class="nav-item">
            HOME
        </div>
        <div class="nav-item">
            ABOUT
        </div>
        
    </div>
    @if(signedInUser.Id!=null){
    <div class="account">
        <img src="" alt="ACCOUNT-LOGO">@signedInUser.UserName
    </div>
    }
    @if (signedInUser.Id == null)
    {
        <div @onclick="RedirectToLogin">Sign In</div>
        <div @onclick="RedirectToRegister">Sign Up</div>
    }
</nav>
@code{
    public string UserId;
    UserDTO signedInUser;

    protected override async Task OnInitializedAsync()
    {
        signedInUser = await LoginService.GetSignedInUserAsync();

    }
    public void RedirectToLogin()
    {
        NavigationManager.NavigateTo("/login");
    }
    public void RedirectToRegister()
    {
        NavigationManager.NavigateTo("/register");
    }
 }